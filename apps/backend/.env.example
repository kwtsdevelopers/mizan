# Mizan backend environment configuration (placeholders only - never commit real secrets)

NODE_ENV=development
PORT=3000

# MongoDB cluster connection (no database name - databases are managed by the platform)
MONGODB_URI=mongodb://127.0.0.1:27017
CORE_DB_NAME=mizan_core
TENANT_DB_PREFIX=mizan_t_

# JWT secrets: REQUIRED in production, must be >= 32 chars and distinct.
JWT_ACCESS_SECRET=change-me-dev-access-secret-32chars!
JWT_REFRESH_SECRET=change-me-dev-refresh-secret-32chars
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_SEC=604800

# Comma separated list of allowed browser origins
CORS_ORIGINS=http://localhost:4200

# Bootstrap platform administrator (created on first start if no admin exists)
PLATFORM_ADMIN_EMAIL=admin@example.com
PLATFORM_ADMIN_PASSWORD=change-me-strong-password
