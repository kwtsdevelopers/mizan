{
  "name": "@mizan/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Mizan platform API (modular monolith, Fastify + NestJS + MongoDB)",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "ts-node --transpile-only src/main.ts",
    "start:memory": "ts-node --transpile-only scripts/start-memory.ts",
    "test": "jest --runInBand",
    "test:e2e": "jest --config jest-e2e.config.js --runInBand"
  },
  "dependencies": {
    "@fastify/helmet": "13.0.1",
    "@fastify/static": "8.0.4",
    "@mizan/shared": "*",
    "@nestjs/common": "11.1.6",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.1.6",
    "@nestjs/jwt": "11.0.0",
    "@nestjs/platform-fastify": "11.1.6",
    "@nestjs/swagger": "11.2.0",
    "@nestjs/throttler": "6.4.0",
    "bcryptjs": "2.4.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "fastify": "5.4.0",
    "mongoose": "8.9.5",
    "nestjs-pino": "4.4.0",
    "pino": "9.6.0",
    "pino-http": "10.4.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@nestjs/testing": "11.1.6",
    "@types/bcryptjs": "2.4.6",
    "@types/jest": "29.5.14",
    "@types/node": "20.17.16",
    "jest": "29.7.0",
    "mongodb-memory-server": "10.1.3",
    "pino-pretty": "13.0.0",
    "ts-jest": "29.2.5",
    "ts-node": "10.9.2",
    "typescript": "5.7.3"
  }
}
